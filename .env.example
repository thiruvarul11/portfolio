# EmailJS Vite Environment Configuration Example
# Replace these with your actual EmailJS credentials from https://dashboard.emailjs.com/

# 1. Email Service ID (e.g. service_xxxxxxx from Email Services tab)
VITE_EMAILJS_SERVICE_ID=service_placeholder

# 2. Email Template ID (e.g. template_xxxxxxx from Email Templates tab)
VITE_EMAILJS_TEMPLATE_ID=template_placeholder

# 3. Public Key (User ID / Public Key from Account Settings > API Keys)
# NOTE: Only expose the Public Key to Vite frontend. NEVER expose your Private Key!
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
